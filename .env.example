NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-secret-key
POLLINATIONS_API_KEY=your-pollinations-key

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/register
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Inngest (Local dev runs zero-config; required for Inngest Cloud / production)
INNGEST_DEV=1
INNGEST_EVENT_KEY=your_inngest_event_key_here
INNGEST_SIGNING_KEY=your_inngest_signing_key_here

# Groq AI (Free high-speed Llama 3.3 70B script generation)
# Get a free API key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Hugging Face (Free Serverless Inference API for FLUX.1-schnell & SDXL image generation)
# Get a free token at https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=your_huggingface_token_here


# Remotion AWS Lambda Rendering (Optional for cloud MP4 rendering)
REMOTION_AWS_ACCESS_KEY_ID=your_aws_access_key_id
REMOTION_AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
REMOTION_AWS_REGION=us-east-1
REMOTION_LAMBDA_FUNCTION_NAME=remotion-render-function-name
REMOTION_SERVE_URL=https://your-remotion-bucket.s3.us-east-1.amazonaws.com/sites/your-site/index.html
